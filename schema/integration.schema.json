{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amitgb14.github.io/conch-integrations/schema/integration.schema.json",
  "title": "conch integration file",
  "description": "KIND/NAME/integration.toml: how conch uses a service's HTTP API for one kind of job. The format is conch's internal/integration/format.md; conch integration check is the final word.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "kind", "name", "label", "key_env"],
  "properties": {
    "format": {"const": 3},
    "kind": {"enum": ["ci", "tickets", "notify", "deploy", "host"]},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
    "label": {"type": "string", "minLength": 1},
    "api": {"type": "string", "pattern": "^https://[^/]+"},
    "base_url": {"const": "ask", "description": "Self-hosted: the person gives the API's URL at install."},
    "key_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "follow_hosts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
                     "description": "Hosts a URL from a reply may be fetched from, never with the key."},
    "docs": {"type": "string", "pattern": "^https://"},
    "adapted_by": {"type": "string", "minLength": 1},
    "adapted": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "key_help": {"type": "string"},
    "auth_header": {"type": "string", "minLength": 1, "description": "The key's header, as a sandbox file says it; [auth] is the usual way."},
    "auth_value": {"type": "string", "pattern": "\\{key\\}"},
    "note": {"type": "string"},
    "auth": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": {"enum": ["header", "bearer", "basic", "url"]},
        "header": {"type": "string", "minLength": 1},
        "value": {"type": "string", "pattern": "\\{key\\}"},
        "scopes": {"type": "array", "items": {"type": "string"}},
        "user_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "detect": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "files": {"type": "array", "items": {"type": "string"}},
        "remotes": {"type": "array", "items": {"type": "string"}},
        "checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "project": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string"}}},
    "states": {"type": "object", "additionalProperties": {"enum": ["pass", "fail", "pending", "canceled", "ready", "building", "failed"]},
               "description": "Every state the API documents, to conch's: a ci file's pass fail pending canceled, a deploy file's ready building failed canceled."},
    "runs": {"$ref": "#/$defs/operation"},
    "failed_log": {"$ref": "#/$defs/operation"},
    "rerun": {"$ref": "#/$defs/operation"},
    "stats": {"$ref": "#/$defs/operation"},
    "list": {"$ref": "#/$defs/operation"},
    "mine": {"$ref": "#/$defs/operation"},
    "get": {"$ref": "#/$defs/operation"},
    "comment": {"$ref": "#/$defs/operation"},
    "link": {"$ref": "#/$defs/operation"},
    "move": {"$ref": "#/$defs/operation"},
    "send": {"$ref": "#/$defs/operation"},
    "previews": {"$ref": "#/$defs/operation"},
    "redeploy": {"$ref": "#/$defs/operation"},
    "promote": {"$ref": "#/$defs/operation"}
  },
  "anyOf": [{"required": ["api"]}, {"required": ["base_url"]}],
  "allOf": [
    {"if": {"properties": {"kind": {"const": "ci"}}}, "then": {"required": ["runs"],
      "properties": {"states": {"additionalProperties": {"enum": ["pass", "fail", "pending", "canceled"]}}}}},
    {"if": {"properties": {"kind": {"const": "deploy"}}}, "then": {"required": ["previews"],
      "properties": {"states": {"additionalProperties": {"enum": ["ready", "building", "failed", "canceled"]}}}}},
    {"if": {"properties": {"kind": {"const": "tickets"}}}, "then": {"required": ["list", "get"]}},
    {"if": {"properties": {"kind": {"const": "notify"}}}, "then": {"required": ["send"]}}
  ],
  "$defs": {
    "call": {"type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE)( [/?].*)?$",
             "description": "\"METHOD /path\" under the API; a notify file's may be the method alone."},
    "fields": {
      "description": "Where each thing is in a reply: a path, or a template over {item.x} when it holds a {.",
      "properties": {
        "items": {"type": "string"}, "id": {"type": "string"}, "key": {"type": "string"},
        "name": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"},
        "state": {"type": "string"}, "status": {"type": "string"}, "status_names": {"type": "string"},
        "commit": {"type": "string"}, "url": {"type": "string"}, "started": {"type": "string"},
        "finished": {"type": "string"}, "job": {"type": "string"}, "comments": {"type": "string"},
        "comment_author": {"type": "string"}, "comment_body": {"type": "string"},
        "environment": {"type": "string"}, "error": {"type": "string"}, "inspect": {"type": "string"}
      }
    },
    "request": {
      "properties": {
        "call": {"$ref": "#/$defs/call"},
        "body": {"type": ["object", "string"]},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "follow": {"type": "string"},
        "text": {"type": "string"},
        "pick": {"type": "string"}
      }
    },
    "step": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/request"}],
      "properties": {"as": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "each": {"type": "string"}}
    },
    "operation": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/fields"}],
      "properties": {"steps": {"type": "array", "items": {"$ref": "#/$defs/step"}, "minItems": 1}}
    }
  }
}
